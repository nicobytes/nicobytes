{
	"name": "slides-nicobytes",
	"compatibility_date": "2026-10-17",
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"routes": [
		{
			"pattern": "slides.nicobytes.com",
			"custom_domain": true
		},
		{
			"pattern": "slides.nicobytes.dev",
			"custom_domain": true
		}
	]
}
